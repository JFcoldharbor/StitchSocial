<!--
  Hype coin — converted from hype-coin.svg (the iOS notifHypeCoin asset).

  The previous conversion copied the SVG's gradient coordinates verbatim. SVG
  defaults to gradientUnits="objectBoundingBox", where x1/y1/x2/y2 and cx/cy/r
  are FRACTIONS of the shape's bounding box; Android VectorDrawable gradients are
  in viewport units. So x2="1" became a gradient spanning one pixel of a 100px
  viewport and r=".72" became a radius of 0.72px — every gradient collapsed to
  its final stop, leaving a flat dark disc with no flame. Three stops had also
  been corrupted to #000000 and the rim stroke from gold to black.

  Coordinates below are in viewport units, computed from each shape's own box.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Rim. bbox is the full viewport, so 0,0 → 1,1 maps to 0,0 → 100,100. -->
    <path android:pathData="M50 0A50 50 0 1 0 50 100 50 50 0 1 0 50 0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="100"
                android:endY="100">
                <item android:color="#FFFFF0A0" android:offset="0"/>
                <item android:color="#FFFFB800" android:offset="0.3"/>
                <item android:color="#FF7A4400" android:offset="0.6"/>
                <item android:color="#FFFFD060" android:offset="0.85"/>
                <item android:color="#FFFFF0A0" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Face. bbox is 93.5 wide from 3.25, so cx .38 → 38.78, cy .32 → 33.17,
         r .72 → 67.32. The .38 stop is gold, not black. -->
    <path android:pathData="M50 3.25A46.75 46.75 0 1 0 50 96.75 46.75 46.75 0 1 0 50 3.25z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38.78"
                android:centerY="33.17"
                android:gradientRadius="67.32">
                <item android:color="#FFFFF5A0" android:offset="0"/>
                <item android:color="#FFFFD700" android:offset="0.38"/>
                <item android:color="#FFCC8800" android:offset="0.72"/>
                <item android:color="#FF6B3A00" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner ring: gold at 40%, which is what the SVG stroke says. -->
    <path
        android:strokeColor="#66FFD700"
        android:strokeWidth="1.4"
        android:pathData="M50 8A42 42 0 1 0 50 92 42 42 0 1 0 50 8z"/>

    <group>
        <clip-path android:pathData="M50 3.25A46.75 46.75 0 1 0 50 96.75 46.75 46.75 0 1 0 50 3.25z"/>

        <!-- Flame, outer. Vertical, bottom to top of its own box (y 76 → 18). -->
        <path android:pathData="M50 76C37 72 27 61 29 49C31 39 38 35 35 24C37 31 38 38 42 43C43 35 46 27 50 18C54 27 57 35 58 43C62 32 60 30 65 23C68 36 63 43 71 51C73 63 63 72 50 76Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="50"
                    android:startY="76"
                    android:endX="50"
                    android:endY="18">
                    <item android:color="#EBFF9500" android:offset="0"/>
                    <item android:color="#99FF4500" android:offset="0.5"/>
                    <item android:color="#0DCC2200" android:offset="1"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Flame, core. Same axis over its own box (y 73 → 26). The .5 stop is
             gold, not black. -->
        <path android:pathData="M50 73C41 70 34 61 36 51C38 43 43 40 41 32C43 38 43 44 47 47C47.5 40 49 33 50 26C51 33 52.5 40 53 47C57 44 57 38 59 32C57 40 62 43 64 51C66 61 59 70 50 73Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="50"
                    android:startY="73"
                    android:endX="50"
                    android:endY="26">
                    <item android:color="#FFFFFFFF" android:offset="0"/>
                    <item android:color="#FFFFFDE0" android:offset="0.22"/>
                    <item android:color="#FFFFD700" android:offset="0.5"/>
                    <item android:color="#FFFF6B00" android:offset="0.78"/>
                    <item android:color="#FFFF2200" android:offset="1"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Hot centre. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillAlpha="0.8"
            android:pathData="M50 55.5A4 6.5 0 1 0 50 68.5 4 6.5 0 1 0 50 55.5z"/>

        <!-- Gloss. The SVG rotates this ellipse 30° about its own centre; its box
             is 28 x 16 from (14,68), so cx .35 → 23.8, cy .28 → 72.48, r .5 → 14. -->
        <group
            android:rotation="30"
            android:pivotX="28"
            android:pivotY="76">
            <path android:pathData="M14 76A14 8 0 1 0 42 76 14 8 0 1 0 14 76z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="23.8"
                        android:centerY="72.48"
                        android:gradientRadius="14">
                        <item android:color="#8CFFFFFF" android:offset="0"/>
                        <item android:color="#00FFFFFF" android:offset="1"/>
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>
