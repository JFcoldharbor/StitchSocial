<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Events geofence presence (WhenInUse / foreground only — no background location). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Profile picture permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" android:minSdkVersion="33" />

    <!-- VIDEO SURFACE FIX: Wake lock for video playback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- FCM PERMISSIONS -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- GOOGLE PLAY BILLING — required for HypeCoin in-app purchases -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera hardware -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- VIDEO SURFACE FIX: OpenGL ES for surface rendering -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Android App Links. autoVerify makes the system fetch
                https://stitchsocial.me/.well-known/assetlinks.json at install
                and, on a match, open these links in the app with NO chooser
                dialog. Without the verification file it silently degrades to a
                "open with" prompt, which is the usual way this looks broken.

                Data attributes within one filter combine as a cross product, so
                this is both hosts x all three paths. Scoped to the paths the app
                can actually route — claiming the whole domain would swallow the
                marketing site, /ambassador and the legal pages, exactly as the
                iOS AASA was about to.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="stitchsocial.me" />
                <data android:host="www.stitchsocial.me" />
                <data android:pathPrefix="/e/" />
                <data android:pathPrefix="/u/" />
                <data android:pathPrefix="/invite/" />
            </intent-filter>

            <!-- stitchsocial://e/{id} etc. Declared in ReferralService as
                 `deepLinkScheme` and never registered, so the custom-scheme half
                 of every generated link pointed at nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stitchsocial" />
            </intent-filter>
        </activity>

        <!-- FILE PROVIDER: Required for sharing video files via Intent -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM SERVICE -->
        <service
            android:name=".services.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM DEFAULT NOTIFICATION ICON -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_name" />

        <!-- FCM DEFAULT NOTIFICATION COLOR (Stitch Cyan) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- FCM DEFAULT NOTIFICATION CHANNEL -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="stitch_notifications" />

    </application>

</manifest>